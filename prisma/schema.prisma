generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  ADMIN
}

enum Gender {
  MALE
  FEMALE
  OTHER
  PREFER_NOT_TO_SAY
}

enum NotificationType {
  INTERVIEW_GENERATION_COMPLETED
  INTERVIEW_GENERATION_FAILED
  FEEDBACK_GENERATION_COMPLETED
  FEEDBACK_GENERATION_FAILED
  CHALLENGE_NEW_COMMENT
  CHALLENGE_COMMENT_REPLY
  CHALLENGE_COMMENT_MENTION
  SYSTEM
}

model User {
  id               String    @id @default(uuid())
  name             String
  email            String    @unique
  password         String?
  role             Role      @default(USER)
  isActive         Boolean   @default(true) @map("is_active")
  provider         String?   @default("LOCAL")
  providerId       String?   @map("provider_id")
  googleId         String?   @unique @map("google_id")
  githubId         String?   @unique @map("github_id")
  avatarUrl        String?   @map("avatar_url")
  resetCode        String?   @map("reset_code")
  resetCodeExpiry  DateTime? @map("reset_code_expiry") @db.Timestamptz(3)
  resetToken       String?   @map("reset_token")
  resetTokenExpiry DateTime? @map("reset_token_expiry") @db.Timestamptz(3)

  gender   Gender?
  birthday DateTime? @db.Timestamptz(3)
  location String?   @db.VarChar(100)
  readme   String?   @db.Text

  notifyInterviewActivity Boolean @default(true) @map("notify_interview_activity")
  notifyComments          Boolean @default(true) @map("notify_comments")
  notifySound             Boolean @default(true) @map("notify_sound")

  // AI Model Preferences
  aiQuestionProvider String  @default("local-qwen") @map("ai_question_provider")
  aiQuestionModel    String  @default("qwen-3b") @map("ai_question_model")
  aiFeedbackProvider String  @default("local-qwen") @map("ai_feedback_provider")
  aiFeedbackModel    String  @default("qwen-3b") @map("ai_feedback_model")
  aiGeminiApiKey     String? @map("ai_gemini_api_key")
  aiOpenaiApiKey     String? @map("ai_openai_api_key")
  aiAnthropicApiKey  String? @map("ai_anthropic_api_key")

  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(3)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  interviews              Interview[]
  interviewAttempts       InterviewAttempt[]
  feedbacks               Feedback[]
  challengeSubmissions    ChallengeSubmission[]
  challengeStars          ChallengeStar[]
  interviewStars          InterviewStar[]
  adminAuditLogs          AdminAuditLog[]
  interviewGenerationJobs InterviewGenerationJob[]
  notifications           Notification[]
  challengeSolutions     ChallengeSolution[]
  solutionUpvotes        SolutionUpvote[]
  solutionComments       SolutionComment[]
  solutionCommentUpvotes SolutionCommentUpvote[]
  solutionViews          SolutionView[]

  @@map("users")
}

model Notification {
  id        String           @id @default(uuid())
  userId    String           @map("user_id")
  type      NotificationType
  title     String
  message   String           @db.Text
  actionUrl String?          @map("action_url")
  metadata  Json?
  readAt    DateTime?        @map("read_at") @db.Timestamptz(3)
  createdAt DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt, createdAt])
  @@index([type])
  @@map("notifications")
}

model AdminAuditLog {
  id         String   @id @default(uuid())
  adminId    String   @map("admin_id")
  action     String
  entityType String   @map("entity_type")
  entityId   String?  @map("entity_id")
  entityName String?  @map("entity_name")
  metadata   Json?
  ipAddress  String?  @map("ip_address")
  userAgent  String?  @map("user_agent")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  admin User @relation(fields: [adminId], references: [id], onDelete: Restrict)

  @@index([adminId])
  @@index([action])
  @@index([entityType])
  @@index([createdAt])
  @@map("admin_audit_logs")
}

model Interview {
  id         String    @id @default(uuid())
  userId     String    @map("user_id")
  role       String
  level      String
  type       String
  techstack  String[]
  questions  String[]
  language   String    @default("en")
  finalized  Boolean   @default(false)
  archivedAt DateTime? @map("archived_at") @db.Timestamptz(3)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  user           User                     @relation(fields: [userId], references: [id])
  attempts       InterviewAttempt[]
  feedbacks      Feedback[]
  generationJobs InterviewGenerationJob[]
  stars          InterviewStar[]

  @@map("interviews")
}

enum InterviewGenerationStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

enum InterviewAttemptStatus {
  IN_PROGRESS
  FEEDBACK_PROCESSING
  COMPLETED
  TOO_SHORT
  FAILED
}

model InterviewGenerationJob {
  id           String                    @id @default(uuid())
  userId       String                    @map("user_id")
  role         String
  level        String
  type         String
  techstack    String[]
  amount       Int
  language     String                    @default("en")
  provider     String?
  status       InterviewGenerationStatus @default(PENDING)
  interviewId  String?                   @map("interview_id")
  errorMessage String?                   @map("error_message") @db.Text
  createdAt    DateTime                  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime                  @updatedAt @map("updated_at") @db.Timestamptz(3)
  completedAt  DateTime?                 @map("completed_at") @db.Timestamptz(3)

  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  interview Interview? @relation(fields: [interviewId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([status])
  @@index([createdAt])
  @@index([interviewId])
  @@map("interview_generation_jobs")
}

model InterviewAttempt {
  id            String                 @id @default(uuid())
  interviewId   String                 @map("interview_id")
  userId        String                 @map("user_id")
  status        InterviewAttemptStatus @default(IN_PROGRESS)
  endedAt       DateTime?              @map("ended_at") @db.Timestamptz(3)
  completedAt   DateTime?              @map("completed_at") @db.Timestamptz(3)
  failureReason String?                @map("failure_reason") @db.Text
  createdAt     DateTime               @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime               @updatedAt @map("updated_at") @db.Timestamptz(3)

  interview   Interview    @relation(fields: [interviewId], references: [id], onDelete: Cascade)
  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  transcripts Transcript[]
  feedback    Feedback?

  @@index([status])
  @@index([userId, status])
  @@index([interviewId, status])
  @@map("interview_attempts")
}

model Transcript {
  id        String   @id @default(uuid())
  attemptId String   @map("attempt_id")
  role      String // "user" | "assistant"
  content   String
  sequence  Int
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  attempt InterviewAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)

  @@map("transcripts")
}

model Feedback {
  id                  String   @id @default(uuid())
  attemptId           String   @unique @map("attempt_id")
  interviewId         String   @map("interview_id")
  userId              String   @map("user_id")
  totalScore          Int      @map("total_score")
  strengths           String[]
  areasForImprovement String[] @map("areas_for_improvement")
  finalAssessment     String   @map("final_assessment")
  createdAt           DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt           DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  attempt        InterviewAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  interview      Interview        @relation(fields: [interviewId], references: [id], onDelete: Cascade)
  user           User             @relation(fields: [userId], references: [id])
  categoryScores CategoryScore[]

  @@map("feedbacks")
}

model CategoryScore {
  id         String @id @default(uuid())
  feedbackId String @map("feedback_id")
  name       String
  score      Int
  comment    String

  feedback Feedback @relation(fields: [feedbackId], references: [id], onDelete: Cascade)

  @@map("category_scores")
}

enum Difficulty {
  EASY
  MEDIUM
  HARD
}

model Skill {
  id          String   @id @default(uuid())
  name        String
  slug        String   @unique
  description String?  @db.Text
  icon        String?
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  challenges Challenge[]

  @@map("skills")
}

model Challenge {
  id           String     @id @default(uuid())
  skillId      String     @map("skill_id")
  title        String
  slug         String     @unique
  description  String     @db.Text
  difficulty   Difficulty @default(EASY)
  topics       String     @default("")
  examples     Json?
  constraints  Json?
  hints        Json?
  solution     String?    @db.Text
  followUps    Json?      @map("follow_ups")
  templateCode Json       @map("template_code")
  testCases    Json       @map("test_cases")
  isActive     Boolean    @default(true) @map("is_active")
  createdAt    DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime   @updatedAt @map("updated_at") @db.Timestamptz(3)

  skill       Skill                 @relation(fields: [skillId], references: [id])
  submissions ChallengeSubmission[]
  stars       ChallengeStar[]
  solutions   ChallengeSolution[]

  @@map("challenges")
}

model ChallengeSubmission {
  id              String   @id @default(uuid())
  challengeId     String   @map("challenge_id")
  userId          String   @map("user_id")
  code            String   @db.Text
  language        String
  status          String   @default("PENDING")
  runtime         Int?
  memory          Int?
  passedTestCases Int?     @map("passed_test_cases")
  totalTestCases  Int?     @map("total_test_cases")
  errorMessage    String?  @map("error_message") @db.Text
  note            String?  @db.Text
  noteColor       String?  @map("note_color")
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  challenge Challenge          @relation(fields: [challengeId], references: [id])
  user      User               @relation(fields: [userId], references: [id])
  solution  ChallengeSolution?

  @@map("challenge_submissions")
}

model ChallengeStar {
  id          String   @id @default(uuid())
  userId      String   @map("user_id")
  challengeId String   @map("challenge_id")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  user      User      @relation(fields: [userId], references: [id])
  challenge Challenge @relation(fields: [challengeId], references: [id])

  @@unique([userId, challengeId])
  @@map("challenge_stars")
}

model InterviewStar {
  id          String   @id @default(uuid())
  userId      String   @map("user_id")
  interviewId String   @map("interview_id")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  interview Interview @relation(fields: [interviewId], references: [id], onDelete: Cascade)

  @@unique([userId, interviewId])
  @@index([userId])
  @@index([interviewId])
  @@map("interview_stars")
}

model ChallengeSolution {
  id           String    @id @default(uuid())
  challengeId  String    @map("challenge_id")
  userId       String    @map("user_id")
  submissionId String    @unique @map("submission_id")
  title        String
  description  String?   @db.Text
  language     String
  code         String    @db.Text
  deletedAt    DateTime? @map("deleted_at") @db.Timestamptz(3)
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  challenge  Challenge           @relation(fields: [challengeId], references: [id], onDelete: Cascade)
  user       User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  submission ChallengeSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  comments   SolutionComment[]
  upvotes    SolutionUpvote[]
  views      SolutionView[]

  @@index([challengeId, createdAt])
  @@index([userId])
  @@index([deletedAt, createdAt])
  @@index([language])
  @@map("challenge_solutions")
}

model SolutionUpvote {
  id         String   @id @default(uuid())
  solutionId String   @map("solution_id")
  userId     String   @map("user_id")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  solution ChallengeSolution @relation(fields: [solutionId], references: [id], onDelete: Cascade)
  user     User              @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, solutionId])
  @@map("solution_upvotes")
}

model SolutionComment {
  id         String    @id @default(uuid())
  solutionId String    @map("solution_id")
  userId     String    @map("user_id")
  parentId   String?   @map("parent_id")
  content    String    @db.Text
  isEdited   Boolean   @default(false) @map("is_edited")
  deletedAt  DateTime? @map("deleted_at") @db.Timestamptz(3)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  solution ChallengeSolution      @relation(fields: [solutionId], references: [id], onDelete: Cascade)
  user     User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  parent   SolutionComment?       @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies  SolutionComment[]      @relation("CommentReplies")
  upvotes  SolutionCommentUpvote[]

  @@index([solutionId, createdAt])
  @@index([parentId])
  @@map("solution_comments")
}

model SolutionCommentUpvote {
  id        String   @id @default(uuid())
  commentId String   @map("comment_id")
  userId    String   @map("user_id")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  comment SolutionComment @relation(fields: [commentId], references: [id], onDelete: Cascade)
  user    User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, commentId])
  @@map("solution_comment_upvotes")
}

model SolutionView {
  id         String   @id @default(uuid())
  solutionId String   @map("solution_id")
  userId     String   @map("user_id")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  solution ChallengeSolution @relation(fields: [solutionId], references: [id], onDelete: Cascade)
  user     User              @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, solutionId])
  @@map("solution_views")
}
